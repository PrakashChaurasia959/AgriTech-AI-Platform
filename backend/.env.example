# ============================================================
# Smart Agriculture Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ---- Application ----
APP_NAME=Smart Agriculture API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api

# ---- Security ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- MongoDB Atlas ----
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT: Add your IP to Atlas Network Access (Security > Network Access)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_agriculture_db?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_agriculture_db
# Fallback to local MongoDB if Atlas is unreachable (e.g. IP not whitelisted)
MONGODB_FALLBACK_URL=mongodb://localhost:27017

# ---- CORS ----
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- Admin Bootstrap ----
# An admin user is auto-created on first startup with these credentials
ADMIN_EMAIL=admin@smartagri.com
ADMIN_PASSWORD=admin123456

# ---- Email (optional - for password reset) ----
# Leave empty to use development reset links (token printed in console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartagri.com

# ---- Weather API ----
# Open-Meteo is free and requires no API key
WEATHER_API_BASE=https://api.open-meteo.com/v1

# ---- ML Model ----
# Set to "production" once you place a trained model at DISEASE_MODEL_PATH
DISEASE_MODEL_MODE=demo
# DISEASE_MODEL_MODE=production

# Path to trained Keras CNN (relative to backend/ or absolute)
DISEASE_MODEL_PATH=ml_models/plant_disease_model.keras
DISEASE_MODEL_INPUT_SIZE=224
DISEASE_MODEL_NUM_CLASSES=38

# Optional: path to a pre-trained sklearn crop model pkl
# If absent the backend auto-trains a Random Forest at startup
CROP_MODEL_PATH=ml_models/crop_recommendation_model.pkl

# ---- OpenWeatherMap (free tier) ----
# Get a free API key at https://openweathermap.org/api
# Leave blank to disable live weather auto-fill on the crop page
OPENWEATHER_API_KEY=
OPENWEATHER_BASE=https://api.openweathermap.org/data/2.5
