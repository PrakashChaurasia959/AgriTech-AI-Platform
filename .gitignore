# ============================================================
# Smart Agriculture System - .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
env/
.venv/
ENV/

# ---- Environment Variables ----
.env
*.env
!.env.example

# ---- ML Model Files ----
*.joblib
*.h5
*.pkl
*.tflite
backend/app/ml/*.joblib

# ---- Node.js / Frontend ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Test ----
.pytest_cache/
.coverage
htmlcov/
